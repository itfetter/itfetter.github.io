# Copy only into the actual BaoTa instance directory; never commit real settings.
IMAGE_TAG=sha-REPLACE_WITH_TESTED_COMMIT
BLOG_PORT=3100
PUBLIC_ORIGIN=https://itfetter.com
# Exact Docker network gateway IP seen by this container from the host Nginx proxy.
# Inspect the actual instance network; do not copy a guessed gateway or trust all IPs.
TRUST_PROXY_IPS=
