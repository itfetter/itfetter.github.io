{
  "name": "itfetter-blog",
  "main": "index.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itfetter-blog",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "itfetter-blog-images"
    }
  ],
  "observability": {
    "enabled": true
  }
}
